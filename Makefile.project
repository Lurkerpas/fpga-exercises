.PHONY: all clean trace

all: trace

verify: ${PROJECT}_tb.vhd ${PROJECT}.vhd
	ghdl -a --std=08 ${PROJECT}.vhd ${PROJECT}_tb.vhd
	ghdl -e --std=08 ${PROJECT}_tb

trace: verify
	ghdl -r --std=08 ${PROJECT}_tb --vcd=trace.vcd --stop-time=1us

view: trace
	gtkwave trace.vcd
clean:
	rm -f *.o *.cf *.ghw *.vcd